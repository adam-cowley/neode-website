---
// Hero: headline + a living graph of the Goodfellas domain, drawn from
// data at build time — border-trimmed edges with direction arrows.
import HeroGraph from './HeroGraph.astro'

const headline = 'Define your graph in TypeScript.'
const accent = 'neode writes the Cypher.'
const sub =
  'A TypeScript object-graph mapper for Neo4j, Aura and Memgraph, with an embedded Relate engine for running in-process. Models in, one Cypher statement per read out. The cell below replays a verified Neo4j run of the quickstart recipe.'
---

<section>
  <div class="wrap" style="padding:clamp(36px,11vw,72px) var(--gutter) 40px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(520px,100%),1fr));gap:48px;align-items:center">
    <div>
      <h1 style="margin:0;font-size:clamp(38px,5vw,58px);line-height:1.06;letter-spacing:-.02em;text-wrap:balance">
        {headline} <span style="color:var(--blue)">{accent}</span>
      </h1>
      <p style="font-size:19px;color:var(--mute);margin:24px 0 32px;max-width:520px;text-wrap:pretty">{sub}</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
        <a class="btn btn-p" href="/playground/">Open the playground</a>
        <button class="btn btn-g" data-copy-install aria-label="Copy install command">
          <span style="color:var(--amber)">$</span> npm install neode@next
          <svg width="22" height="16" viewBox="0 0 22 16" aria-hidden="true" data-copy-graphic>
            <path d="M5 8 L17 8" stroke="var(--mute)" stroke-width="2"></path>
            <circle cx="4" cy="8" r="3.5" fill="var(--mute)"></circle>
            <circle cx="18" cy="8" r="3.5" fill="var(--mute)"></circle>
          </svg>
          <span style="font-weight:400;color:var(--mute);min-width:50px" data-copy-label>copy</span>
        </button>
      </div>
    </div>
    <div style="min-width:0">
      <div class="hg-d"><HeroGraph scale={1} uid="d" /></div>
      <div class="hg-m"><HeroGraph scale={1.2} uid="m" /></div>
    </div>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-install]')
  btn?.addEventListener('click', () => {
    navigator.clipboard?.writeText('npm install neode@next').then(() => {
      const label = btn.querySelector('[data-copy-label]')
      const graphic = btn.querySelector<SVGPathElement>('[data-copy-graphic] path')
      if (label) label.textContent = 'copied ✓'
      graphic?.setAttribute('stroke', 'var(--blue)')
      setTimeout(() => {
        if (label) label.textContent = 'copy'
        graphic?.setAttribute('stroke', 'var(--mute)')
      }, 1500)
    })
  })
</script>

<style>
  .hg-m {
    display: none;
  }
  @media (max-width: 600px) {
    .hg-d {
      display: none;
    }
    .hg-m {
      display: block;
    }
  }
</style>
