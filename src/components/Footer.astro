    <span style="color:var(--text);font-weight:700;font-size:14px">neode</span>
    <a class="nl" style="min-height:0" href="/docs/api-reference/">API reference</a>
    <a class="nl" style="min-height:0" href="/docs/migration/">Migration guide</a>
    <a class="nl" style="min-height:0" href="/llms.txt">llms.txt</a>
    <a class="nl" style="min-height:0" href="https://github.com/adam-cowley/neode">GitHub</a>
