---
const version = '1.0.0-next.1'
---

<footer style="border-top:1px solid var(--line);background:var(--surf)">
  <div class="wrap" style="padding-top:28px;padding-bottom:28px;display:flex;flex-wrap:wrap;gap:12px 28px;align-items:center;font-size:12px;color:var(--mute)">
    <span style="color:var(--text);font-weight:700;font-size:14px">neode</span>
    <a class="nl foot-l" href="/docs/api-reference/">API reference</a>
    <a class="nl foot-l" href="/docs/migration/">Migration guide</a>
    <a class="nl foot-l" href="/llms.txt">llms.txt</a>
    <a class="nl foot-l" href="https://github.com/adam-cowley/neode">GitHub</a>
    <span style="margin-left:auto">runs on Relate · compiled to WebAssembly · {version}</span>
  </div>
</footer>

<style>
  /* 44px tap target only when touch-sized; desktop keeps the compact row */
  .foot-l {
    min-height: 0;
  }
  @media (max-width: 720px) {
    .foot-l {
      min-height: 44px;
    }
  }
</style>
