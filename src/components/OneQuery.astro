---
// One query per read — code + round-trip diagram
import Code from './Code.astro'

const CODE = `@NodeEntity()
export class Movie {
  @Property({ type: 'string', unique: true, primary: true })
  title: string

  @OneToMany(() => Person, 'ACTED_IN', { direction: 'out', eager: true })
  actors: Person[]
}

const movie = await neode.find(Movie, title, { with: { actors: true } })
// one Cypher statement, fully hydrated`
---

<section style="border-top:1px solid var(--line);background:var(--surf)">
  <div class="wrap" style="padding:clamp(44px,11vw,88px) var(--gutter)">
    <h2 style="margin:0 0 12px;font-size:clamp(32px,4vw,46px);line-height:1.08;letter-spacing:-.015em">One query per read.</h2>
    <p style="margin:0 0 40px;color:var(--mute);max-width:640px">Eager loading and read-model decorators compile into a single Cypher statement. No N+1, however deep the hydration.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(440px,100%),1fr));gap:32px;align-items:start">
      <Code code={CODE} label="movie.ts" />
      <div style="display:flex;flex-direction:column;gap:20px">
        <div>
          <div style="font-size:12px;color:var(--mute);margin-bottom:10px">hand-rolled hydration · 1 + N round trips</div>
          <div style="display:flex;flex-direction:column;gap:6px">
            <div style="height:14px;width:100%;border-radius:7px;background:var(--mute);opacity:.55"></div>
            <div style="display:flex;gap:6px">
              {[0, 1, 2, 3, 4, 5].map(() => <div style="height:14px;flex:1;border-radius:7px;background:var(--amber)" />)}
            </div>
          </div>
        </div>
        <div>
          <div style="font-size:12px;color:var(--blue);margin-bottom:10px">neode · 1 statement</div>
          <div style="height:14px;width:100%;border-radius:7px;background:var(--blue)"></div>
        </div>
        <a class="btn btn-g" style="align-self:flex-start" href="/why-ogm/">See the side-by-side</a>
      </div>
    </div>
  </div>
</section>
