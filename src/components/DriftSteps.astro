---
// The schema-drift workflow as five steps
const steps = [
  { name: 'installSchema()', body: 'Create constraints and indexes from your models.' },
  { name: 'inspectSchema()', body: 'Diff what is declared against what is installed.' },
  { name: 'schemaDrift()', body: 'List the differences as data.' },
  { name: 'formatSchemaDrift()', body: 'Render them for a person to review.' },
  { name: 'applySchemaDrift()', body: 'Bring the database in line — and re-probe the drift it left with returnDriftAfter (NTS-659).', accent: true },
]
---

<div style="display:flex;flex-wrap:wrap;gap:12px;align-items:stretch">
  {
    steps.map((s, i) => (
      <div class="step" style={s.accent ? 'border-color:var(--blue)' : ''}>
        <div style={`font-size:12px;margin-bottom:8px;color:${s.accent ? 'var(--blue)' : 'var(--amber)'}`}>{i + 1}</div>
        <div style="font-weight:700;font-size:14px;margin-bottom:6px">{s.name}</div>
        <div style="color:var(--mute);font-size:14px">{s.body}</div>
      </div>
    ))
  }
</div>
