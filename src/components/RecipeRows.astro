---
import { recipes } from '../lib/recipes'
import VerifyChip from './VerifyChip.astro'
---

<div style="border-bottom:1px solid var(--line)">
  {
    recipes
      .filter((r) => r.id !== 'quickstart')
      .map((r, i) => (
        <div class="row">
          <span style="color:var(--mute);padding-left:8px">{String(i + 1).padStart(2, '0')}</span>
          <span style="font-weight:700;font-size:15px">
            {r.title}.ts <VerifyChip id={r.id} />
          </span>
          <span style="color:var(--mute)">{r.blurb}</span>
          <a class="open" href={`/playground/?recipe=${r.id}`}>
            Open in playground →
          </a>
        </div>
      ))
  }
</div>
