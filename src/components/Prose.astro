---
// Prose styling for repo-synced markdown pages (shared by the docs pages)
---

<style is:global>
  .prose {
    font-size: 14px;
    line-height: 1.85;
    color: var(--mute);
  }
  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    color: var(--text);
    margin: 56px 0 16px;
    scroll-margin-top: 84px;
  }
  .prose h1 {
    font-size: 30px;
  }
  .prose h2 {
    font-size: 26px;
  }
  .prose h3 {
    font-size: 20px;
  }
  .prose a {
    color: var(--blue);
  }
  .prose strong {
    color: var(--text);
  }
  .prose code {
    color: var(--ty);
    background: var(--code);
    padding: 2px 6px;
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.95em;
    overflow-wrap: anywhere; /* long identifiers must not force horizontal scroll */
  }
  .prose pre {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--code) !important;
    padding: var(--code-pad);
    overflow-x: auto;
    font-family: inherit;
    font-size: 13px;
    line-height: 1.8;
  }
  .prose pre code {
    overflow-wrap: normal;
    background: transparent;
    padding: 0;
    color: inherit;
  }
  .prose table {
    border-collapse: collapse;
    width: 100%;
    font-size: 13px;
    display: block;
    overflow-x: auto;
  }
  .prose th,
  .prose td {
    border: 1px solid var(--line);
    padding: 8px 12px;
    text-align: left;
  }
  .prose th {
    color: var(--text);
    background: var(--surf2);
  }
  .prose blockquote {
    border-left: 3px solid var(--amber);
    margin: 0;
    padding: 4px 20px;
    background: var(--surf);
    border-radius: 0 12px 12px 0;
  }
  .prose ul,
  .prose ol {
    padding-left: 24px;
  }
  .prose hr {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 40px 0;
  }
</style>
