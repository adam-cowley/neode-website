---
// Four steps. Really.
const steps = [
  { n: '1', tone: 'amber', title: 'Install', body: 'npm install neode@next' },
  { n: '2', tone: 'amber', title: 'Connect', body: 'Neo4j, Aura, or Neode.forRelate(database)' },
  { n: '3', tone: 'amber', title: 'Define a model', body: '@NodeEntity() or defineModel()' },
  { n: '4', tone: 'blue', title: 'Create, read, update, delete', body: 'neode.create · find · update · delete' },
]
---

<section>
  <div class="wrap" style="padding:72px 32px 96px">
    <h2 style="margin:0 0 40px;font-size:clamp(32px,4vw,46px);line-height:1.08;letter-spacing:-.015em">From install to first query in four steps.</h2>
    <ol style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(250px,100%),1fr));gap:20px">
      {
        steps.map((s) => (
          <li style="border:1px solid var(--line);border-radius:16px;background:var(--surf);padding:22px">
            <div
              style={`width:40px;height:40px;border-radius:12px;background:${s.tone === 'blue' ? 'var(--blue)' : 'var(--amber)'};color:${s.tone === 'blue' ? 'var(--onblue)' : 'var(--onnode)'};display:flex;align-items:center;justify-content:center;font-weight:700;margin-bottom:14px`}
            >
              {s.n}
            </div>
            <div style="font-weight:700;font-size:19px;margin-bottom:6px">{s.title}</div>
            <div style="font-size:13px;color:var(--mute)">{s.body}</div>
          </li>
        ))
      }
    </ol>
    <div style="margin-top:36px;display:flex;flex-wrap:wrap;gap:12px">
      <a class="btn btn-p" href="/playground/">Run it in the playground</a>
      <a class="btn btn-g" href="/examples/">Browse the cookbook</a>
    </div>
  </div>
</section>
