---
// Docs shell: sidebar + content + on-this-page + prev/next
interface DocPage {
  slug: string
  label: string
  title: string
}

export const GUIDE: DocPage[] = [
  { slug: 'models', label: 'Defining models', title: 'Defining models' },
  { slug: 'relationships', label: 'Relationships', title: 'Relationships' },
  { slug: 'traversals', label: 'Traversals', title: 'Traversals' },
  { slug: 'search', label: 'Vector and full-text search', title: 'Vector and full-text search' },
]

interface Props {
  current: string
  toc?: Array<{ href: string; label: string }>
  prev?: { href: string; label: string }
  next?: { href: string; label: string }
}

const { current, toc = [], prev, next } = Astro.props
---

<div class="wrap wrap-wide docs-shell">
  <!-- LEFT NAV -->
  <nav aria-label="Documentation" class="docs-side">
    <div class="gh">Guide</div>
    {
      GUIDE.map((p) => (
        <a class="side" href={`/docs/reference/${p.slug}/`} aria-current={p.slug === current ? 'page' : undefined}>
          {p.label}
        </a>
      ))
    }
    <div class="gh">Reference</div>
    <a class="side" href="/docs/api-reference/">API reference</a>
    <a class="side" href="/docs/migration/">Migration guide</a>
    <a class="side" href="/llms.txt">llms.txt</a>
    <a class="side" href="/examples/">Cookbook</a>
  </nav>

  <!-- CONTENT -->
  <main style="flex:999 1 560px;min-width:0;max-width:820px">
    {
      toc.length > 0 && (
        <details class="docs-toc-m">
          <summary>On this page</summary>
          {toc.map((t) => <a class="toc" href={t.href}>{t.label}</a>)}
        </details>
      )
    }
    <slot />

    <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;margin-top:56px;padding-top:24px;border-top:1px solid var(--line)">
      {prev ? <a class="btn btn-g" href={`/docs/reference/${prev.href}/`}>← {prev.label}</a> : <span />}
      {next ? <a class="btn btn-g" href={`/docs/reference/${next.href}/`}>{next.label} →</a> : <span />}
    </div>
  </main>

  <!-- TOC -->
  <aside aria-label="On this page" class="docs-toc">
    <div class="gh" style="padding-left:0">On this page</div>
    {toc.map((t) => <a class="toc" href={t.href}>{t.label}</a>)}
  </aside>
</div>

<style>
  .docs-shell {
    padding-top: 32px;
    padding-bottom: 96px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px 40px;
    align-items: flex-start;
  }
  .docs-side {
    flex: 0 0 240px;
    min-width: 0;
    margin-top: -32px;
    position: sticky;
    top: 84px;
    align-self: flex-start;
    max-height: calc(100vh - 100px);
    overflow: auto;
  }
  .docs-toc {
    flex: 0 0 200px;
    min-width: 0;
    margin-top: -32px;
    position: sticky;
    top: 84px;
    align-self: flex-start;
  }
  .docs-toc-m {
    display: none;
  }
  @media (max-width: 900px) {
    .docs-shell {
      gap: 16px;
      padding-top: 16px;
    }
    .docs-side {
      flex: 1 0 100%;
      position: static;
      margin-top: 0;
      max-height: none;
      display: flex;
      gap: 4px 12px;
      overflow-x: auto;
      align-items: center;
      border-bottom: 1px solid var(--line);
    }
    .docs-side :global(.gh) {
      display: none;
    }
    .docs-side :global(.side) {
      flex: 0 0 auto;
      width: auto;
      white-space: nowrap;
    }
    .docs-toc {
      display: none;
    }
    .docs-toc-m {
      display: block;
      margin-bottom: 24px;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 0 16px;
    }
    .docs-toc-m summary {
      min-height: 44px;
      display: flex;
      align-items: center;
      cursor: pointer;
      color: var(--mute);
    }
    .docs-toc-m :global(.toc) {
      display: block;
      min-height: 44px;
      line-height: 44px;
    }
  }
</style>
