---
// Docs shell: sidebar + content + on-this-page + prev/next
interface DocPage {
  slug: string
  label: string
  title: string
}

export const GUIDE: DocPage[] = [
  { slug: 'models', label: 'Defining models', title: 'Defining models' },
  { slug: 'relationships', label: 'Relationships', title: 'Relationships' },
  { slug: 'cardinality', label: 'Cardinality & claims', title: 'Cardinality & claims' },
  { slug: 'traversals', label: 'Traversals', title: 'Traversals' },
  { slug: 'search', label: 'Vector and full-text search', title: 'Vector and full-text search' },
]

interface Props {
  current: string
  toc?: Array<{ href: string; label: string }>
  prev?: { href: string; label: string }
  next?: { href: string; label: string }
}

const { current, toc = [], prev, next } = Astro.props
---

<div class="wrap wrap-wide" style="padding:32px 32px 96px;display:flex;flex-wrap:wrap;gap:32px 40px;align-items:flex-start">
  <!-- LEFT NAV -->
  <nav aria-label="Documentation" style="flex:0 0 240px;min-width:0;margin-top:-32px;position:sticky;top:84px;align-self:flex-start;max-height:calc(100vh - 100px);overflow:auto">
    <div class="gh">Guide</div>
    {
      GUIDE.map((p) => (
        <a class="side" href={`/docs/reference/${p.slug}/`} aria-current={p.slug === current ? 'page' : undefined}>
          {p.label}
        </a>
      ))
    }
    <div class="gh">Reference</div>
    <a class="side" href="/docs/api-reference/">API reference</a>
    <a class="side" href="/docs/migration/">Migration guide</a>
    <a class="side" href="/llms.txt">llms.txt</a>
    <a class="side" href="/examples/">Cookbook</a>
  </nav>

  <!-- CONTENT -->
  <main style="flex:999 1 560px;min-width:0;max-width:820px">
    <slot />

    <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;margin-top:56px;padding-top:24px;border-top:1px solid var(--line)">
      {prev ? <a class="btn btn-g" href={`/docs/reference/${prev.href}/`}>← {prev.label}</a> : <span />}
      {next ? <a class="btn btn-g" href={`/docs/reference/${next.href}/`}>{next.label} →</a> : <span />}
    </div>
  </main>

  <!-- TOC -->
  <aside aria-label="On this page" style="flex:0 0 200px;min-width:0;margin-top:-32px;position:sticky;top:84px;align-self:flex-start">
    <div class="gh" style="padding-left:0">On this page</div>
    {toc.map((t) => <a class="toc" href={t.href}>{t.label}</a>)}
  </aside>
</div>
