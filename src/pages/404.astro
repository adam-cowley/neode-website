---
import Base from '../layouts/Base.astro'
---

<Base title="neode — Page not found">
  <div style="min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:28px;padding:48px var(--gutter);text-align:center">
    <svg width="120" height="80" viewBox="0 0 120 80" aria-hidden="true">
      <circle cx="60" cy="40" r="16" fill="none" stroke="var(--mute)" stroke-width="2" stroke-dasharray="4 6"></circle>
      <circle cx="60" cy="40" r="4" fill="var(--amber)"></circle>
    </svg>
    <h1 style="margin:0;font-size:clamp(30px,5vw,52px);line-height:1.15;letter-spacing:-.02em;text-wrap:balance">This page has been DETACH DELETEd.</h1>
    <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center">
      <a class="btn btn-p" href="/">Back to the home page</a>
    </div>
  </div>
</Base>
