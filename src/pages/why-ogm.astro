---
import Base from '../layouts/Base.astro'
import CompareRaw from '../components/CompareRaw.astro'
import ErrorCards from '../components/ErrorCards.astro'
import DriftSteps from '../components/DriftSteps.astro'
---

<Base title="neode — Why an OGM?">
  <section>
    <div class="wrap" style="padding:72px 32px 56px">
      <h1 style="margin:0;font-size:clamp(38px,5vw,60px);line-height:1.05;letter-spacing:-.02em;max-width:880px;text-wrap:balance">An OGM is the part of your graph code you stop re-writing.</h1>
      <p style="font-size:18px;color:var(--mute);margin:20px 0 0;max-width:660px">
        An object-graph mapper turns models into Cypher and records back into typed objects. You still get a graph. You
        lose the string-building, the unwrapping, and the schema bookkeeping.
      </p>
    </div>
  </section>

  <section style="border-top:1px solid var(--line);background:var(--surf)">
    <div class="wrap" style="padding:72px 32px">
      <h2 style="margin:0 0 36px;font-size:clamp(28px,3.5vw,40px);line-height:1.1;letter-spacing:-.015em">Create one person.</h2>
      <CompareRaw />
    </div>
  </section>

  <section id="one-query">
    <div class="wrap" style="padding:88px 32px">
      <h2 style="margin:0 0 12px;font-size:clamp(28px,3.5vw,40px);line-height:1.1;letter-spacing:-.015em">One query per read.</h2>
      <p style="margin:0 0 40px;color:var(--mute);max-width:620px">
        Hydrating a movie and its cast by hand usually means one query for the movie and one more per related node.
        Eager loading and read-model decorators fold all of it into a single statement.
      </p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(460px,100%),1fr));gap:24px">
        <div style="border:1px solid var(--line);border-radius:16px;background:var(--surf);padding:24px">
          <div style="font-size:12px;color:var(--mute);margin-bottom:18px">hand-rolled · 1 + N round trips</div>
          <div style="display:flex;align-items:center;gap:16px">
            <div style="border:2px solid var(--amber);border-radius:12px;padding:14px 16px;font-weight:700;font-size:13px">app</div>
            <div style="flex:1;display:flex;flex-direction:column;gap:6px">
              <div style="height:10px;border-radius:5px;background:var(--mute);opacity:.6"></div>
              <div style="display:flex;gap:4px">
                {[0, 1, 2, 3, 4].map(() => <div style="height:10px;flex:1;border-radius:5px;background:var(--amber)" />)}
              </div>
            </div>
            <div style="border:2px solid var(--line);border-radius:12px;padding:14px 16px;font-weight:700;font-size:13px">graph</div>
          </div>
          <p style="margin:18px 0 0;color:var(--mute);font-size:14px">Every extra edge to hydrate is another trip. Latency grows with the size of the answer.</p>
        </div>
        <div style="border:1px solid var(--blue);border-radius:16px;background:var(--surf);padding:24px">
          <div style="font-size:12px;color:var(--blue);margin-bottom:18px">neode · 1 statement</div>
          <div style="display:flex;align-items:center;gap:16px">
            <div style="border:2px solid var(--amber);border-radius:12px;padding:14px 16px;font-weight:700;font-size:13px">app</div>
            <div style="flex:1"><div style="height:10px;border-radius:5px;background:var(--blue)"></div></div>
            <div style="border:2px solid var(--blue);border-radius:12px;padding:14px 16px;font-weight:700;font-size:13px">graph</div>
          </div>
          <p style="margin:18px 0 0;color:var(--mute);font-size:14px">
            <span style="color:var(--text)">@RelatedOne</span>, <span style="color:var(--text)">@RelatedMany</span>,
            <span style="color:var(--text)">@RelationshipCount</span>, <span style="color:var(--text)">@Computed</span> and
            <span style="color:var(--text)">@Expression</span> all project into the same statement.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="errors" style="border-top:1px solid var(--line);background:var(--surf)">
    <div class="wrap" style="padding:88px 32px">
      <h2 style="margin:0 0 12px;font-size:clamp(28px,3.5vw,40px);line-height:1.1;letter-spacing:-.015em">Errors you can switch on.</h2>
      <p style="margin:0 0 36px;color:var(--mute);max-width:620px">
        A typed taxonomy instead of parsing driver messages. Validation failures arrive together, before anything reaches
        the database.
      </p>
      <ErrorCards />
    </div>
  </section>

  <section id="drift">
    <div class="wrap" style="padding:88px 32px">
      <h2 style="margin:0 0 12px;font-size:clamp(28px,3.5vw,40px);line-height:1.1;letter-spacing:-.015em">A migration workflow for your schema.</h2>
      <p style="margin:0 0 36px;color:var(--mute);max-width:620px">
        Your models declare constraints and indexes. neode compares them with what is installed and walks you from one to
        the other.
      </p>
      <DriftSteps />
      <div style="margin-top:48px;display:flex;flex-wrap:wrap;gap:12px">
        <a class="btn btn-p" href="/playground/">Open the playground</a>
        <a class="btn btn-g" href="/docs/migration/">Migration guide</a>
      </div>
    </div>
  </section>
</Base>
